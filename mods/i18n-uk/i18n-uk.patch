Subject: [PATCH 1/2] feat(i18n): add Ukrainian translation

The language switcher already had an "ua" entry in its display-name
map, but no ua.json resource was registered, so it was unreachable.

(cherry picked from commit 22eb44d5a91f36cf00956b52ccbbeca2df3a73f0)
---
 frontend/src/localization/i18n.js         |  4 ++
 frontend/src/localization/locales/ua.json | 51 +++++++++++++++++++++++
 2 files changed, 55 insertions(+)
 create mode 100644 frontend/src/localization/locales/ua.json

diff --git a/frontend/src/localization/i18n.js b/frontend/src/localization/i18n.js
index 6fc5eec..f413556 100644
--- a/frontend/src/localization/i18n.js
+++ b/frontend/src/localization/i18n.js
@@ -3,6 +3,7 @@ import { initReactI18next } from "react-i18next";
 import English from './locales/en.json'
 import Russian from './locales/ru.json'
 import SimplifiedChinese from './locales/zh_cn.json'
+import Ukrainian from './locales/ua.json'
 import LanguageDetector from 'i18next-browser-languagedetector';
 
 // the translations
@@ -17,6 +18,9 @@ const resources = {
     },
     zh_cn: {
         translation: SimplifiedChinese
+    },
+    ua: {
+        translation: Ukrainian
     }
 };
 
