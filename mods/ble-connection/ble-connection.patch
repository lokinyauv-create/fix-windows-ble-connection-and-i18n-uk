From 75cd30ffd4537036319bf43b7e7aeda0809b8741 Mon Sep 17 00:00:00 2001
From: Lina <lokinyauv@gmail.com>
Date: Thu, 6 Aug 2026 22:24:49 +0200
Subject: [PATCH 6/6] fix: scan for a base station the adapter can no longer
 resolve

Connecting by address fails outright if the adapter hasn't observed
the device recently - Windows reports "device with the given address
was not found", BlueZ has no D-Bus object to talk to - and a station
that has simply been idle for a while falls into that state while
sitting there powered on and advertising perfectly well.

Confirmed with a standalone probe against a station the app had given
up on: connecting cold failed, an 8s scan saw it immediately at
rssi -36, and connecting straight afterwards succeeded and enumerated
all six services.

So on a "not found" failure, scan until the address turns up and then
retry. The scan stops the moment the station is seen and holds a mutex
so two never overlap, because scanning on top of another station's
service discovery is what made discovery hang in the first place.

Verified end to end: a station that previously exhausted all six
attempts with "device with the given address was not found" now
connects on the first, and both stations get their automatic wake.

(cherry picked from commit 74a3d459e7844e9870f015c7740a3a423f21d6b7)
---
 bs.go         | 44 ++++++++++++++++++++++++++++++++++++++++++++
 bs_other.go   | 11 ++++++++++-
 bs_windows.go | 10 +++++++++-
 3 files changed, 63 insertions(+), 2 deletions(-)

diff --git a/bs.go b/bs.go
index 3c19e9a..9b284c5 100644
--- a/bs.go
+++ b/bs.go
@@ -70,6 +70,50 @@ func BaseStationIsConnecting(id string) bool {
 	return connecting
 }
 
+// scanMutex keeps discovery passes from overlapping each other. Scanning while
+// another station is enumerating its GATT services is what made discovery hang
+// on Windows, so a scan is kept as short as it can be and never runs twice at
+// once.
+var scanMutex sync.Mutex
+
+// discoverBaseStation scans until the given address shows up, so the OS can
+// resolve it. Both backends refuse to connect by address to a device they
+// haven't observed recently - Windows fails outright with "device with the
+// given address was not found", BlueZ with a missing D-Bus object - and a
+// station that was simply idle long enough falls into that state even though
+// it is powered on and advertising normally.
+func discoverBaseStation(mac string, timeout time.Duration) bool {
+	scanMutex.Lock()
+	defer scanMutex.Unlock()
+
+	log.Printf("Scanning so the adapter can resolve %s...\n", mac)
+
+	found := make(chan struct{})
+	var once sync.Once
+
+	go adapter.Scan(func(a *bluetooth.Adapter, sr bluetooth.ScanResult) {
+		if strings.EqualFold(sr.Address.String(), mac) {
+			once.Do(func() { close(found) })
+		}
+	})
+
+	seen := false
+	select {
+	case <-found:
+		seen = true
+	case <-time.After(timeout):
+	}
+
+	adapter.StopScan()
+
+	// Let the radio settle before the connect attempt - overlapping the two is
+	// exactly what breaks service discovery.
+	time.Sleep(500 * time.Millisecond)
+
+	log.Printf("Scan for %s finished, found: %v\n", mac, seen)
+	return seen
+}
+
 func PreloadBaseStation(config BaseStationConfiguration, wakeUp bool) BaseStation {
