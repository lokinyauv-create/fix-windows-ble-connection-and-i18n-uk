From ddfd109eb045ed5f98bd5e31e293f328e38e1bed Mon Sep 17 00:00:00 2001
From: Lina <lokinyauv@gmail.com>
Date: Sat, 26 Sep 2026 19:25:00 +0200
Subject: [PATCH 5/5] fix: wait for pending power commands before releasing the
 stations on exit

When SteamVR stops, the sleep commands go out and the app quits right
away. disconnectAllBaseStations used to drop the links immediately, so a
write-only station got a single sleep command - exactly the case that
stations on old firmware sometimes ignore. Wait (up to 16 s) until every
station has confirmed or finished re-sending its last command.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app.go | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/app.go b/app.go
index dbf9cd2..5deac03 100644
--- a/app.go
+++ b/app.go
@@ -126,6 +126,25 @@ func (a *App) startup(ctx context.Context) {
 // the connection at the daemon level, so it survives the process exiting and
 // the station stays claimed until something explicitly disconnects it.
 func disconnectAllBaseStations() {
+	// A sleep command sent right before exit is still being re-sent to the
+	// write-only stations; disconnecting now would leave them with a single
+	// attempt, which they sometimes ignore. Give the confirmation loops time
+	// to finish first.
+	deadline := time.Now().Add(16 * time.Second)
+	for time.Now().Before(deadline) {
+		pending := false
+		for _, bs := range knownBaseStations.Items() {
+			if bs != nil && (*bs).PowerCommandPending() {
+				pending = true
+				break
+			}
+		}
+		if !pending {
+			break
+		}
+		time.Sleep(250 * time.Millisecond)
